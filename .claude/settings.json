{
  "extraKnownMarketplaces": {
    "importing": {
      "source": {
        "source": "github",
        "repo": "dogi/kotlin-importing"
      }
    },
    "overtaking": {
      "source": {
        "source": "github",
        "repo": "dogi/branch-overtaking"
      }
    },
    "prepping": {
      "source": {
        "source": "github",
        "repo": "dogi/merge-prepping"
      }
    },
    "summoning": {
      "source": {
        "source": "github",
        "repo": "dogi/agents-summoning"
      }
    }
  },
  "enabledPlugins": {
    "agents-summoning@summoning": true,
    "branch-overtaking@overtaking": true,
    "kotlin-importing@importing": true,
    "merge-prepping@prepping": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__Claude_Code_Remote__create_session|mcp__Claude_Code_Remote__archive_session",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/spawned-session-ledger.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/spawned-session-ledger.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__Claude_Code_Remote__create_session",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/spawn-brake.sh"
          }
        ]
      }
    ]
  }
}
