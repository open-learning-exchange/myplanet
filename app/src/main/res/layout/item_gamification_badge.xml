<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_badge"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Badge Icon Container -->
        <FrameLayout
            android:id="@+id/fl_badge_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_badge_unlocked_circle">

            <TextView
                android:id="@+id/tv_badge_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="26sp"
                tools:text="🎓" />

            <ImageView
                android:id="@+id/iv_badge_check"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_check_circle"
                android:contentDescription="@string/unlocked_badge"
                app:tint="@color/status_completed" />
        </FrameLayout>

        <!-- Badge Info & Progress -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_badge_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/dashboard_ink_1"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Course Graduate" />

                <TextView
                    android:id="@+id/tv_badge_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/list_status_completed_text"
                    tools:text="Unlocked" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_badge_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/dashboard_ink_3"
                android:textSize="13sp"
                tools:text="Complete 1 full course" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/pb_badge_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_bar_flat"
                tools:progress="60" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
