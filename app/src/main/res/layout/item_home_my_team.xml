<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dashboard_chip_width"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_chip"
    android:padding="@dimen/dashboard_hairline_width">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="invisible" />
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/dashboard_chip_padding">

        <ImageView
            android:layout_width="@dimen/dashboard_chip_icon_size"
            android:layout_height="@dimen/dashboard_chip_icon_size"
            app:srcCompat="@drawable/team"
            app:tint="@color/dashboard_chip_icon_teams"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/dashboard_ink_2"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/coverTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/dashboard_chip_cover_strip"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingHorizontal="@dimen/dashboard_chip_padding"
        android:paddingVertical="6dp"
        android:textColor="@color/dashboard_chip_cover_title"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_chat"
            android:layout_width="@dimen/dashboard_chip_icon_size"
            android:layout_height="@dimen/dashboard_chip_icon_size"
            android:layout_margin="4dp"
            android:visibility="gone"
            app:srcCompat="@drawable/message_alert"
            app:tint="@color/md_red_500" />
        <ImageView
            android:id="@+id/img_task"
            android:layout_width="@dimen/dashboard_chip_icon_size"
            android:layout_height="@dimen/dashboard_chip_icon_size"
            android:layout_margin="4dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_warn"
            app:tint="@color/md_red_500" />
    </LinearLayout>
</FrameLayout>
