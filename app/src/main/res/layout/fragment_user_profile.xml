<?xml version="1.0" encoding="utf-8"?>
<!-- Structure is identical across configurations (see layout-land/ and layout-sw600dp/): banner
     padding, avatar size, card side padding and the details-grid column count all come from
     dimens/integers overridden per qualifier, so this one file already serves phone portrait,
     phone landscape and tablet/foldable. The qualified copies exist so the intent is explicit
     per breakpoint and to guarantee the resource lookup for @integer/profile_grid_columns etc. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/dashboard_page_bg"
    tools:context=".ui.user.UserProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/profile_scroll_bottom_padding">

        <!-- Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/profile_banner_padding_top"
            android:paddingStart="@dimen/padding_large"
            android:paddingEnd="@dimen/padding_large"
            android:paddingBottom="@dimen/profile_banner_padding_bottom">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/image"
                    android:layout_width="@dimen/profile_avatar_size"
                    android:layout_height="@dimen/profile_avatar_size"
                    android:src="@drawable/profile"
                    app:civ_border_color="@color/profile_avatar_ring"
                    app:civ_border_width="@dimen/profile_avatar_ring_width" />

                <ImageButton
                    android:id="@+id/bt_profile_pic"
                    android:layout_width="@dimen/profile_fab_size"
                    android:layout_height="@dimen/profile_fab_size"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/profile_fab_inset"
                    android:layout_marginBottom="@dimen/profile_fab_inset"
                    android:background="@drawable/bg_profile_fab_ring"
                    android:contentDescription="@string/edit_image"
                    android:elevation="@dimen/profile_card_elevation_details"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/profile_fab_icon_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_edit"
                    android:tint="@color/colorPrimary" />
            </FrameLayout>

            <TextView
                android:id="@+id/txt_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_banner_gap"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/profile_name_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_secondary_gap"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/profile_text_on_primary_secondary"
                android:textSize="@dimen/profile_secondary_text_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btEditProfile"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_banner_gap"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="@dimen/profile_touch_target_min"
                android:paddingStart="@dimen/padding_large"
                android:paddingEnd="@dimen/padding_large"
                android:text="@string/edit_profile"
                android:textAllCaps="false"
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/profile_button_text_size"
                app:backgroundTint="@color/profile_button_fill_on_primary"
                app:cornerRadius="@dimen/profile_button_radius"
                app:rippleColor="@color/profile_button_fill_on_primary"
                app:strokeColor="@color/profile_button_stroke_on_primary"
                app:strokeWidth="@dimen/dashboard_hairline_width" />

            <TextView
                android:id="@+id/guest_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_banner_gap"
                android:background="@drawable/bg_profile_guest_pill"
                android:paddingStart="@dimen/profile_pill_padding_horizontal"
                android:paddingTop="@dimen/profile_pill_padding_vertical"
                android:paddingEnd="@dimen/profile_pill_padding_horizontal"
                android:paddingBottom="@dimen/profile_pill_padding_vertical"
                android:text="@string/profile_guest_banner_message"
                android:textColor="@color/md_white_1000"
                android:textSize="@dimen/profile_pill_text_size"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Details card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/profile_card_overlap_margin">

            <org.ole.planet.myplanet.ui.components.MaxWidthFrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:paddingStart="@dimen/profile_card_side_padding"
                android:paddingEnd="@dimen/profile_card_side_padding"
                app:maxContentWidth="@dimen/profile_card_max_width">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="@dimen/profile_card_radius"
                    app:cardElevation="@dimen/profile_card_elevation_details"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="@dimen/dashboard_hairline_width">

                    <GridLayout
                        android:id="@+id/details_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="@integer/profile_grid_columns"
                        android:paddingTop="@dimen/profile_card_padding_vertical"
                        android:paddingBottom="@dimen/profile_card_padding_vertical">

                        <include
                            android:id="@+id/row_email"
                            layout="@layout/row_profile_detail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal" />

                        <include
                            android:id="@+id/row_dob"
                            layout="@layout/row_profile_detail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal" />

                        <include
                            android:id="@+id/row_gender"
                            layout="@layout/row_profile_detail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal" />

                        <include
                            android:id="@+id/row_language"
                            layout="@layout/row_profile_detail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal" />

                        <include
                            android:id="@+id/row_level"
                            layout="@layout/row_profile_detail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal" />
                    </GridLayout>
                </com.google.android.material.card.MaterialCardView>
            </org.ole.planet.myplanet.ui.components.MaxWidthFrameLayout>
        </FrameLayout>

        <!-- Activity card -->
        <org.ole.planet.myplanet.ui.components.MaxWidthFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingStart="@dimen/profile_card_side_padding"
            android:paddingEnd="@dimen/profile_card_side_padding"
            android:paddingTop="@dimen/profile_section_gap"
            app:maxContentWidth="@dimen/profile_card_max_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingTop="@dimen/profile_section_label_padding_top"
                    android:paddingBottom="@dimen/profile_section_label_padding_bottom"
                    android:text="@string/profile_activity_section"
                    android:textColor="@color/hint_color"
                    android:textSize="@dimen/profile_label_text_size" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="@dimen/profile_card_radius"
                    app:cardElevation="@dimen/profile_card_elevation_activity"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="@dimen/dashboard_hairline_width">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_stat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/profile_card_padding_vertical"
                        android:paddingBottom="@dimen/profile_card_padding_vertical" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </org.ole.planet.myplanet.ui.components.MaxWidthFrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
