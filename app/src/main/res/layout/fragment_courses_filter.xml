<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:padding="@dimen/padding_normal"
    tools:context=".ui.courses.CoursesFilterFragment">

    <TextView
        android:id="@+id/tv_filter_title"
        style="@style/HeaderText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="@string/filter"
        app:layout_constraintEnd_toStartOf="@id/iv_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/close"
        android:padding="@dimen/padding_normal"
        android:src="@drawable/outline_close_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/daynight_textColor" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_close">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_normal"
                android:text="@string/grade_level"
                android:textColor="@color/daynight_textColor" />
            <Spinner
                android:id="@+id/spn_grade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/grade_level" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_normal"
                android:text="@string/subject_level"
                android:textColor="@color/daynight_textColor" />
            <Spinner
                android:id="@+id/spn_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/subject_level" />
            <Button
                android:id="@+id/btn_collections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/padding_normal"
                android:background="?attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:text="@string/collections"
                android:textAllCaps="false"
                android:textColor="@color/daynight_textColor"
                app:drawableEndCompat="@drawable/down_arrow"
                app:drawableTint="@color/daynight_textColor" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/filter_footer_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/card_border"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollView" />
    <LinearLayout
        android:id="@+id/filter_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="@dimen/padding_normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filter_footer_divider">

        <Button
            android:id="@+id/btn_clear_tags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:background="?attr/selectableItemBackground"
            android:text="@string/clear_tags"
            android:textAllCaps="false"
            android:textColor="@color/daynight_textColor" />
        <Button
            android:id="@+id/btn_confirm_filters"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:background="@drawable/buttonblue"
            android:textAllCaps="false"
            android:textColor="@color/textColorPrimary"
            tools:text="@string/show_n_results" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
