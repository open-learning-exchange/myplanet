    <dimen name="dashboard_tile_icon_size">22dp</dimen>
    <dimen name="dashboard_chip_icon_size">14dp</dimen>
    <dimen name="dashboard_chip_padding">4dp</dimen>
    <dimen name="dashboard_chip_gap">2dp</dimen>
</resources>
